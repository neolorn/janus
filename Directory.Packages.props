<Project>

  <!-- CONV-SETUP-002: every package version lives here and none in a project file.
       CONV-DESIGN-008: this file is the dependency allow-list; its entries are
       exactly the packages that table permits. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Relational access">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
    <PackageVersion Include="Dapper" Version="2.1.86" />
  </ItemGroup>

  <ItemGroup Label="Cache">
    <PackageVersion Include="StackExchange.Redis" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup Label="Cryptography and authentication">
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Fido2" Version="4.0.1" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup Label="OpenID Connect">
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.7.1" />
    <PackageVersion Include="OpenIddict.Server" Version="7.7.1" />
    <PackageVersion Include="OpenIddict.Validation" Version="7.7.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.4.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.15.0" />
  </ItemGroup>

</Project>
