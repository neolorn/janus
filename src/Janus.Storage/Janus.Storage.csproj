<Project Sdk="Microsoft.NET.Sdk">

  <!-- CONV-DESIGN-007: the container's abstractions are the shared framework's, taken
       by a reference and never as a package (CONV-DESIGN-008). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Janus.Core\Janus.Core.csproj" />
    <ProjectReference Include="..\Janus.Identity\Janus.Identity.csproj" />
    <ProjectReference Include="..\Janus.Authentication\Janus.Authentication.csproj" />
    <ProjectReference Include="..\Janus.Authorization\Janus.Authorization.csproj" />
    <ProjectReference Include="..\Janus.Privacy\Janus.Privacy.csproj" />
  </ItemGroup>

  <!-- OPS-DATA-001: LINQ for everything normal, Dapper for hand-written SQL.
       CONV-DESIGN-003: the design package is this project's alone and builds the
       migration bundle, so it ships with nothing.
       CONV-DESIGN-008: the relational package is referenced directly, so every project
       that reaches this one resolves it at the version of the core package. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <!-- CONV-DESIGN-008: the provider's store interfaces are hand-written here over the
       one context, so this project carries the server package the interfaces come in
       and no store package of the server's own. -->
  <ItemGroup>
    <PackageReference Include="OpenIddict.Server" />
  </ItemGroup>

  <!-- CONV-CODE-008 AC2: referenced as an analyser, never as a library. -->
  <ItemGroup>
    <ProjectReference Include="..\Janus.Analyzers\Janus.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Janus.Storage.Tests" />
    <InternalsVisibleTo Include="Janus.Hosting" />
    <InternalsVisibleTo Include="Janus.Hosting.Tests" />
    <InternalsVisibleTo Include="Janus.Cli" />
  </ItemGroup>

</Project>
