<Project Sdk="Microsoft.NET.Sdk">

  <!-- AUTHZ-MODEL-004, D-160: the hosted service and the middleware pipeline are the
       shared framework's, which is a reference and not a package (CONV-DESIGN-008). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- AUTH-OIDC-001, CONV-DESIGN-008: the protocol, the formats and the signatures are
       the library's, never hand-written; the stores behind them are. -->
  <ItemGroup>
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.Server" />
    <PackageReference Include="OpenIddict.Validation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Janus.Core\Janus.Core.csproj" />
    <ProjectReference Include="..\Janus.Identity\Janus.Identity.csproj" />
    <ProjectReference Include="..\Janus.Authentication\Janus.Authentication.csproj" />
    <ProjectReference Include="..\Janus.Authorization\Janus.Authorization.csproj" />
    <ProjectReference Include="..\Janus.Privacy\Janus.Privacy.csproj" />
    <ProjectReference Include="..\Janus.Storage\Janus.Storage.csproj" />
  </ItemGroup>

  <!-- CONV-CODE-008 AC2: referenced as an analyser, never as a library. -->
  <ItemGroup>
    <ProjectReference Include="..\Janus.Analyzers\Janus.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- AUTH-PASS-004, INT-PWD-002: the offline list travels in the package, so the
       fallback answers on a deployment that holds no file of its own. -->
  <ItemGroup>
    <EmbeddedResource Include="Passwords\leaked-passwords.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Janus.Hosting.Tests" />
  </ItemGroup>

</Project>
