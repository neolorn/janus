<Project Sdk="Microsoft.NET.Sdk">

  <!-- AUTHZ-MODEL-004, D-160: the hosted service and the middleware pipeline are the
       shared framework's, which is a reference and not a package (CONV-DESIGN-008). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- AUTH-OIDC-001, CONV-DESIGN-008: the protocol, the formats and the signatures are
       the library's, never hand-written; the stores behind them are. -->
  <ItemGroup>
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.Server" />
    <PackageReference Include="OpenIddict.Validation" />
  </ItemGroup>

  <!-- LIB-PKG-001, CONV-LAYOUT-001 (D-205): this project packs as the main package. The
       areas are no packages of their own: their assemblies travel in this one, and the
       packages they reference at run time are referenced here, so that the main package
       declares each as a dependency. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);AreaAssemblies</TargetsForTfmSpecificBuildOutput>
    <!-- A pack that builds nothing reads the areas' output where their build left it. -->
    <BuildProjectReferences Condition="'$(NoBuild)' == 'true'">false</BuildProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Janus.Core\Janus.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Janus.Identity\Janus.Identity.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Janus.Authentication\Janus.Authentication.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Janus.Authorization\Janus.Authorization.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Janus.Privacy\Janus.Privacy.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Janus.Storage\Janus.Storage.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Fido2" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Otp.NET" />
  </ItemGroup>

  <!-- The assemblies of the areas, and the documentation of the contracts beside this
       project's own. -->
  <Target Name="AreaAssemblies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->'%(RootDir)%(Directory)%(Filename).xml')"
                            Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'Janus.Core.dll'" />
    </ItemGroup>
  </Target>

  <!-- CONV-CODE-008 AC2: referenced as an analyser, never as a library. -->
  <ItemGroup>
    <ProjectReference Include="..\Janus.Analyzers\Janus.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- AUTH-PASS-004, INT-PWD-002: the offline list travels in the package, so the
       fallback answers on a deployment that holds no file of its own. -->
  <ItemGroup>
    <EmbeddedResource Include="Passwords\leaked-passwords.txt" />
  </ItemGroup>

  <!-- AUTH-PASS-004, D-166: the dictionary source's lists travel in the package. The
       English list is the 3esl list of 12dicts 6.0.2, kept to single lower-case words of
       four letters or more and refused below 10,000; the Arabic list gains the variants
       its rules generate, each rule applied on its own to every entry. -->
  <Target Name="DictionaryWords" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <DictionaryWordsFolder>$(IntermediateOutputPath)Passwords\</DictionaryWordsFolder>
      <EnglishWords>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Passwords\3esl.txt'))</EnglishWords>
      <EnglishWords>$([System.Text.RegularExpressions.Regex]::Replace($(EnglishWords), '(?m)^(?![a-z]{4,}\r?$).*(?:\r?\n|$)', ''))</EnglishWords>
      <EnglishWords>$([System.Text.RegularExpressions.Regex]::Replace($(EnglishWords), '\r?\n', ';'))</EnglishWords>
      <ArabicWords>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Passwords\arabic-transliteration.txt'))</ArabicWords>
      <ArabicWords>$([System.Text.RegularExpressions.Regex]::Replace($(ArabicWords), '(?m)^(?![a-z2357]{4,}\r?$).*(?:\r?\n|$)', ''))</ArabicWords>
      <ArabicWords>$([System.Text.RegularExpressions.Regex]::Replace($(ArabicWords), '\r', ''))</ArabicWords>
      <!-- The letter each Arabizi digit stands for, and the digit written as nothing. -->
      <ArabicLetters>$(ArabicWords.Replace('7', 'h').Replace('5', 'kh').Replace('3', 'a').Replace('2', 'a'))</ArabicLetters>
      <ArabicSilent>$(ArabicWords.Replace('7', 'h').Replace('5', 'kh').Replace('3', '').Replace('2', ''))</ArabicSilent>
      <!-- The spellings one vowel or consonant is written in. -->
      <ArabicVowels>$([System.Text.RegularExpressions.Regex]::Replace($(ArabicWords), 'ou|oo', 'u'))</ArabicVowels>
      <ArabicLongE>$(ArabicWords.Replace('ee', 'i'))</ArabicLongE>
      <ArabicJeem>$(ArabicWords.Replace('g', 'j'))</ArabicJeem>
      <ArabicEnding>$([System.Text.RegularExpressions.Regex]::Replace($(ArabicWords), '(?m)a$', 'ah'))</ArabicEnding>
      <ArabicArticle>$([System.Text.RegularExpressions.Regex]::Replace($(ArabicWords), '(?m)^el', 'al'))</ArabicArticle>
      <ArabicWords>$(ArabicWords)&#10;$(ArabicLetters)&#10;$(ArabicSilent)&#10;$(ArabicVowels)&#10;$(ArabicLongE)&#10;$(ArabicJeem)&#10;$(ArabicEnding)&#10;$(ArabicArticle)</ArabicWords>
      <ArabicWords>$([System.Text.RegularExpressions.Regex]::Replace($(ArabicWords), '(?m)^(?![a-z2357]{4,}$).*(?:\n|$)', ''))</ArabicWords>
      <ArabicWords>$([System.Text.RegularExpressions.Regex]::Replace($(ArabicWords), '\n', ';'))</ArabicWords>
    </PropertyGroup>
    <ItemGroup>
      <EnglishWord Include="$([MSBuild]::Unescape($(EnglishWords)))" />
      <ArabicWord Include="$([MSBuild]::Unescape($(ArabicWords)))" />
    </ItemGroup>
    <Error Condition="@(EnglishWord->Count()) &lt; 10000"
           Text="The English word list holds @(EnglishWord->Count()) words; AUTH-PASS-004 asks for at least 10,000." />
    <WriteLinesToFile File="$(DictionaryWordsFolder)english-words.txt"
                      Lines="@(EnglishWord->Distinct())"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(DictionaryWordsFolder)arabic-words.txt"
                      Lines="@(ArabicWord->Distinct())"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(DictionaryWordsFolder)english-words.txt"
                        LogicalName="$(RootNamespace).Passwords.english-words.txt" />
      <EmbeddedResource Include="$(DictionaryWordsFolder)arabic-words.txt"
                        LogicalName="$(RootNamespace).Passwords.arabic-words.txt" />
      <FileWrites Include="$(DictionaryWordsFolder)english-words.txt;$(DictionaryWordsFolder)arabic-words.txt" />
    </ItemGroup>
  </Target>

  <!-- INT-PWD-001, CONV-CODE-004: the range requests name the library's package, whose
       identifier and version the build writes as constants (D-168). -->
  <PropertyGroup>
    <LibraryPackageConstants>true</LibraryPackageConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Janus.Hosting.Tests" />
  </ItemGroup>

</Project>
