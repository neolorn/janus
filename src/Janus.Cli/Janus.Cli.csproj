<Project Sdk="Microsoft.NET.Sdk">

  <!-- LIB-PKG-001, CONV-LAYOUT-001 (D-205): a .NET tool package carrying what it runs,
       its command the neutral word of CONV-NAME-001. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>identity</ToolCommandName>
  </PropertyGroup>

  <!-- CONV-DESIGN-007: the container's abstractions are the shared framework's, taken
       by a reference and never as a package (CONV-DESIGN-008). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Janus.Core\Janus.Core.csproj" />
    <ProjectReference Include="..\Janus.Storage\Janus.Storage.csproj" />
    <ProjectReference Include="..\Janus.Identity\Janus.Identity.csproj" />
    <ProjectReference Include="..\Janus.Authentication\Janus.Authentication.csproj" />
    <ProjectReference Include="..\Janus.Privacy\Janus.Privacy.csproj" />
  </ItemGroup>

  <!-- CONV-CODE-008 AC2: referenced as an analyser, never as a library. -->
  <ItemGroup>
    <ProjectReference Include="..\Janus.Analyzers\Janus.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Janus.Cli.Tests" />
  </ItemGroup>

</Project>
