<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Janus.Conformance\Janus.Conformance.csproj" />
  </ItemGroup>

  <!-- CONV-LAYOUT-001: a package the shared framework serves resolves from the
       framework, never as a package. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- LIB-API-002 AC2, AUTH-OIDC-001: the sample host's schema is applied and its
       client registered from the server, by the commands an operator runs, so the
       command-line application is built beside it. It runs from its own
       build output: this project's output resolves the shared dependencies for the web
       framework the tests run on, which the command does not run on. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Janus.Cli\Janus.Cli.csproj" />
    <AssemblyMetadata Include="CommandLineApplicationDirectory" Value="$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'src', 'Janus.Cli', 'bin', '$(Configuration)', '$(TargetFramework)'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

</Project>
